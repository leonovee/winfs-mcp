node_modules/
dist/
coverage/
.vitest-cache/
*.log
.DS_Store

# Scratch / debug artifacts in the repo root (recreatable; never commit).
# Root-anchored (/) so they don't shadow tracked files in subdirectories
# such as audit/external_reviews/.../_gemini_prompt.txt. *.log above already
# covers transport.log / _build.log / _tsc.log; the entries below add the
# .txt scratch files (_ff.txt, _gitcheck.txt, _gitstatus.txt) and editor .bak.
/transport.log
/.transport.log
/_*.txt
*.bak

# Local Claude Code state (per-machine)
.claude/settings.local.json

# Local working config with real paths (not the template)
configs/local.json

# Secrets — never commit. Reviewer infrastructure copies API keys from
# C:\Users\User\Desktop\ai\ai-judge\.env into winfs\.env (D2 of v0.8.0
# reviewer-restore prompt). The file is also generally any local-only
# env-var bag.
.env
.env.local
.env.*.local

# Smoke test artifacts (Inspector probes — recreatable, harmless if absent)
test-cyrillic.txt
desktop-test.txt
test-inspector/
archived.txt
archived.backup.txt

# OS / editor
Thumbs.db
.vscode/
.idea/
